# Copy to .env (git-ignored) and fill in. Read by apps/server only.

# Port the Express server listens on.
PORT=8787

# demo = fixture providers only (no network, no key needed); live = Muse Spark + PH FDA.
PROVIDER_MODE=demo

# Server-only secret. Required when PROVIDER_MODE=live. Never put this in apps/mobile.
MODEL_API_KEY=

# Daily (UTC) spend cap for live model calls; live analyze/explain return 503 LIVE_BUDGET_EXHAUSTED once reached.
DAILY_SPEND_CAP_USD=5

# Public repository URL, used in the PH FDA User-Agent header.
PUBLIC_REPO_URL=

# Optional allowed CORS origin. Leave empty to disable CORS headers.
CORS_ORIGIN=

# Proxy hops in front of the server whose X-Forwarded-For is trusted for the per-client rate
# limit (a hop count such as 1, or false). Default: 1 when NODE_ENV=production, else false.
# Behind a hosting proxy (most HTTPS hosts) leave it at 1; with false every user shares one
# 30-requests-per-minute bucket. Never "true": any client could then pick its own limit key.
TRUST_PROXY=
