# Copy to .env (git-ignored) at the repository root and fill in.
# The Go services read .env from the working directory (run them from the
# repository root), or the file named by ENV_FILE. A variable already set in
# the environment wins over .env. Blank means "not set".
#
# Never put MODEL_API_KEY or MCP_API_TOKENS in apps/mobile: they are server-side
# secrets. Startup errors name the bad variable, never its value.

# ---------------------------------------------------------------- shared
# Read by services/api and services/mcp (the same application services).

# mock (default) = deterministic demo label, no network, results marked
# isDemo:true / DEMO DATA. muse_spark = the live Meta Model API (muse-spark-1.3).
# There is no fallback between them.
MODEL_PROVIDER=mock

# fixture (default) = demo registry rows. ph_fda = the live PH FDA verification search.
REFERENCE_PROVIDER=fixture

# Required when MODEL_PROVIDER=muse_spark (startup fails without it).
MODEL_API_KEY=

# Daily (UTC) spend cap for live model calls, in US dollars. Once reached, live
# analyses and explanations return 503 LIVE_BUDGET_EXHAUSTED. 0 disables live calls.
DAILY_SPEND_CAP_USD=5

# Public repository URL, sent in the PH FDA User-Agent (MediLensAI/0.1 (+URL)).
PUBLIC_REPO_URL=

# ------------------------------------------------------- services/api only

# TCP port the REST + SSE API listens on (all interfaces).
PORT=8787

# The one browser origin that gets CORS headers, e.g. http://localhost:8081.
# Empty = no CORS headers (the Android app does not need them).
CORS_ORIGIN=

# CIDR ranges of the proxies in front of the API whose X-Forwarded-For is
# honoured for per-client rate limits, e.g. 10.0.0.0/8. Empty = the socket peer
# is the client. Never list ranges you do not control.
TRUSTED_PROXIES=

# Optional: another env file to read instead of ./.env (set it in the shell).
# ENV_FILE=

# Optional Go runtime memory limit; set it to the container limit less headroom.
# GOMEMLIMIT=400MiB

# ------------------------------------------------------- services/mcp only

# host:port for the Streamable HTTP endpoint /mcp. Default 127.0.0.1:8788.
MCP_ADDR=

# Comma-separated bearer tokens (16+ visible ASCII characters each). Required
# unless MCP_ALLOW_NO_AUTH=1 and MCP_ADDR is a loopback address.
MCP_API_TOKENS=

# 1 = serve without auth, allowed on loopback only. Leave empty otherwise.
MCP_ALLOW_NO_AUTH=

# ----------------------------------------- services/eval and services/smoke
# Both use MODEL_API_KEY (required), and DAILY_SPEND_CAP_USD (eval) or
# PUBLIC_REPO_URL (smoke) from above. They make live, paid calls: run by hand only.

# ----------------------------------------------------------- apps/mobile
# Not read from this file. Set it in apps/mobile/.env or the EAS profile: a URL,
# not a secret. On a phone, localhost is the phone, so use the computer's LAN address.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8787
