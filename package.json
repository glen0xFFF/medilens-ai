{
  "name": "medilens-ai",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:contract",
    "test:contract": "vitest run --config scripts/contract/vitest.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/parity && tsc --noEmit -p scripts/contract",
    "lint": "eslint .",
    "parity:record": "tsx scripts/parity/record.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
