{
  "name": "medilens-ai",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present && npm run test:contract",
    "test:contract": "vitest run --config scripts/contract/vitest.config.ts",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/parity && tsc --noEmit -p scripts/contract",
    "lint": "eslint .",
    "go:test": "go test ./...",
    "go:vet": "go vet ./...",
    "go:fmt": "node scripts/dev/gofmt-check.mjs",
    "go:staticcheck": "go run honnef.co/go/tools/cmd/staticcheck@v0.8.2 ./...",
    "go:lint": "npm run go:vet && npm run go:fmt && npm run go:staticcheck",
    "dev:api": "go run ./services/api",
    "dev:mcp": "go run ./services/mcp",
    "demo": "node scripts/dev/go.mjs MODEL_PROVIDER=mock REFERENCE_PROVIDER=fixture -- run ./services/api",
    "eval:labels": "go run ./services/eval",
    "smoke:live": "go run ./services/smoke",
    "parity:record": "tsx scripts/parity/record.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
