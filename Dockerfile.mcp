# MediLens MCP server (services/mcp): multi-stage build, distroless static image.
#
# UNVERIFIED on the dev machine: Docker is not installed there, so this file
# has never been built. The build commands inside it (CGO_ENABLED=0 go build
# of ./services/mcp) were run on the dev machine outside Docker.
#
# In a container the server must bind a non-loopback address
# (MCP_ADDR=0.0.0.0:8788), and then it refuses to start without bearer
# tokens in MCP_API_TOKENS. MCP_ALLOW_NO_AUTH=1 only works on loopback.
#
#   docker build -f Dockerfile.mcp -t medilens-mcp .
#   docker run --rm -p 127.0.0.1:8788:8788 -e MCP_API_TOKENS=<long random token> medilens-mcp

FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY services ./services
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mcp ./services/mcp

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/mcp /mcp
ENV MCP_ADDR=0.0.0.0:8788
EXPOSE 8788
USER nonroot:nonroot
ENTRYPOINT ["/mcp"]
